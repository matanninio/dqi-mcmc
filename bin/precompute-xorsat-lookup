#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
# Copyright 2026 IBM Corporation
#
# Pre-compute and cache the XOR-SAT lookup table for a given m.
# Must be run once per (m, ell) before running xorsat-sampling.
#
# Usage:
#   bin/precompute-xorsat-lookup --m 250
#   bin/precompute-xorsat-lookup --m 1000 --ell 78
#   bin/precompute-xorsat-lookup --m 250 --force   # overwrite existing
#
# All arguments are forwarded verbatim to scripts/precompute_xorsat_lookup.py.
# Run with --help for the full option list.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$SCRIPT_DIR/.."

exec "$ROOT/.venv/bin/python" "$ROOT/scripts/precompute_xorsat_lookup.py" "$@"
