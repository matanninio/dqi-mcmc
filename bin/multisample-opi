#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
# Copyright 2025 The DQI-MCMC Authors
#
# Collect N good OPI samples and print a results table.
#
# Usage:
#   bin/multisample-opi -C --p 13 --idx 1 --num-samples 6
#   bin/multisample-opi -R --p 13 --idx 1 --num-samples 10
#   bin/multisample-opi --algorithm 1 --p 13 --idx 1 --num-samples 6
#
# Algorithm flags (required, mutually exclusive):
#   -C / --continuous     Algorithm 1: single continuous Gibbs run
#   -R / --restart        Algorithm 2: independent restart per sample
#   --algorithm 1|2       Numeric alias
#
# Key parameters:
#   --p INT               Prime modulus
#   --idx INT             RHS index (0-based)
#   --num-samples INT     Number of good samples to collect
#   --num-bit-flips INT   Gibbs block size (default: 3)
#   --seed-offset INT     Added to deterministic seed (default: 0)
#   --n-factor INT        n = p // n_factor (default: 2)
#   --max-steps INT       Safety cap on Gibbs steps per attempt (default: 10 000 000)
#
# Output columns (tab-separated):
#   algorithm  idx  sample_number  tau_dqi  f_value  x
#
# All arguments are forwarded verbatim to scripts/multisample_opi.py.
# Run with --help for the full option list.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$SCRIPT_DIR/.."

exec "$ROOT/.venv/bin/python" "$ROOT/scripts/multisample_opi.py" "$@"
