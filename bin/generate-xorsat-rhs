#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
# Copyright 2025 The DQI-MCMC Authors
#
# Generate random XOR-SAT right-hand side vectors.
#
# Usage:
#   bin/generate-xorsat-rhs --m 250
#   bin/generate-xorsat-rhs --m 1000 --seed 42 --n-samples 50
#
# All arguments are forwarded verbatim to scripts/generate_xorsat_rhs.py.
# Run with --help for the full option list.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$SCRIPT_DIR/.."

exec "$ROOT/.venv/bin/python" "$ROOT/scripts/generate_xorsat_rhs.py" "$@"
