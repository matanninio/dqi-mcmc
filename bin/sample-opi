#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
# Copyright 2026 The DQI-MCMC Authors
#
# Run one OPI Gibbs-sampling trial and print a human-readable summary.
#
# Usage:
#   bin/sample-opi --p 13 --idx 8
#   bin/sample-opi --p 13 --idx 12
#   bin/sample-opi --p 43 --idx 3 --max-steps 10000000
#
# Key parameters:
#   --p INT            Prime modulus
#   --idx INT          RHS index (0-based)
#   --seed-offset INT  Added to deterministic seed (default: 0)
#   --n-factor INT     n = p // n_factor (default: 2)
#   --max-steps INT    Safety cap on Gibbs steps (default: 10 000 000)
#
# All arguments are forwarded verbatim to scripts/sample_opi.py.
# Run with --help for the full option list.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$SCRIPT_DIR/.."

exec "$ROOT/.venv/bin/python" "$ROOT/scripts/sample_opi.py" "$@"
